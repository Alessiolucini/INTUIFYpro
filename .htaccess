# IntuiFy Landing Page - Apache Configuration
# Security headers and URL rewriting

# Enable rewrite engine
<IfModule mod_rewrite.c>
    RewriteEngine On

    # Never serve repository internals, dependencies, notes or monitoring configs
    # (defense in depth: .dockerignore already keeps them out of the image)
    RewriteRule (^|/)\.git(/|$) - [F,L]
    RewriteRule ^(vendor|INTUIFY|monitoring|\.agents)(/|$) - [F,L]

    # Force HTTPS (via reverse proxy header — Traefik handles TLS)
    RewriteCond %{HTTP:X-Forwarded-Proto} !https
    RewriteCond %{HTTPS} off
    RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
    
    # Redirect www to non-www (canonical domain: intuify.net)
    RewriteCond %{HTTP_HOST} ^www\.intuify\.net$ [NC]
    RewriteRule ^(.*)$ https://intuify.net/$1 [L,R=301]
    
    # Remove trailing slash (except root /)
    RewriteCond %{REQUEST_URI} !^/$
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.*)/$ /$1 [L,R=301]
    
    # Hide .php extension - clean URLs
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME}.php -f
    RewriteRule ^(.*)$ $1.php [L]
</IfModule>

# Security headers
<IfModule mod_headers.c>
    # Prevent clickjacking
    Header always set X-Frame-Options "SAMEORIGIN"
    
    # Prevent MIME type sniffing
    Header always set X-Content-Type-Options "nosniff"
    
    # XSS Protection
    Header always set X-XSS-Protection "1; mode=block"
    
    # Referrer Policy
    Header always set Referrer-Policy "strict-origin-when-cross-origin"

    # HSTS: the site is HTTPS-only (TLS terminated by Traefik)
    Header always set Strict-Transport-Security "max-age=15552000"
    
    # Content Security Policy (adjust as needed)
    # Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.tailwindcss.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:;"
</IfModule>

# Disable directory listing
Options -Indexes

# Protect sensitive files
<FilesMatch "^\.">
    Order allow,deny
    Deny from all
</FilesMatch>

<FilesMatch "(composer\.json|composer\.lock|package\.json|README\.md)$">
    Order allow,deny
    Deny from all
</FilesMatch>

# Build, deploy, schema and debug files
<FilesMatch "(\.(sh|sql|md|lock|log|ya?ml)|^Dockerfile|^skills-lock\.json|^config\.example\.php|^test_.*\.php)$">
    Order allow,deny
    Deny from all
</FilesMatch>

# Protect i18n directory from direct access
<IfModule mod_rewrite.c>
    RewriteRule ^i18n/ - [F,L]
</IfModule>

# Compression
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css application/javascript application/json
</IfModule>

# Cache static assets
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/png "access plus 1 month"
    ExpiresByType image/jpeg "access plus 1 month"
    ExpiresByType image/svg+xml "access plus 1 month"
    ExpiresByType text/css "access plus 1 week"
    ExpiresByType application/javascript "access plus 1 week"
</IfModule>
